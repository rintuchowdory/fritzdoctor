# Copy this file to .env and fill in your real values. Never commit .env.

# FritzBox local address (default is usually fritz.box or 192.168.178.1)
FRITZ_ADDRESS=192.168.178.1

# FritzBox login (Heimnetz > Netzwerk > Benutzer, or the box's admin login)
FRITZ_USERNAME=your-fritzbox-username
FRITZ_PASSWORD=your-fritzbox-password

# CORS: the origin your frontend runs on
FRONTEND_ORIGIN=http://localhost:5173
